# --- Database ---
# Postgres connection string (Render/Fly/Railway/etc all provide one).
# For quick local testing you can use SQLite instead:
#   DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Generate a real secret for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# --- AI pipeline ---
# If true, script upload waits for the entire AI pipeline to finish before
# responding (simpler, but the upload request can take 10-60s depending on
# script length and whether the models are already warmed). If false
# (default), upload returns immediately with status="processing" and the
# pipeline runs in a background task; poll GET /scripts/{id}/dashboard and
# watch `pipeline_stage` advance until status flips to "completed".
RUN_PIPELINE_SYNC=false

# --- OpenAI ---
# Required for OpenAI-backed analysis (emotion, character tracking, shot
# suggestions, BGM recommendations, scene importance, cost estimation,
# storyboard). Get a key at https://platform.openai.com/api-keys.
#
# If this is left blank, the app does NOT fail to start -- every analysis
# stage automatically falls back to its local model / deterministic
# heuristic instead (see app/services/openai_service.py and the relevant
# app/ai/*.py module for which fallback applies to which feature).
OPENAI_API_KEY=
# gpt-5-nano is the default and recommended model for this app: it's fast
# and inexpensive, which matters since the upload pipeline can make several
# calls per script (one per scene for some stages). Override only if you
# have a specific reason to use a different model.
OPENAI_MODEL=gpt-5-nano
# Per-request timeout in seconds.
OPENAI_TIMEOUT_SECONDS=30
# Retries for transient failures (rate limits, connection errors, timeouts)
# before falling back to the local model / heuristic.
OPENAI_MAX_RETRIES=2
# Scene importance and cost estimation are scored for the whole script in
# one batched call (rather than per-scene) when this is true -- much lower
# token usage, and importance scoring needs whole-script context anyway to
# judge scenes *relative to each other*. Scripts longer than ~60 scenes
# always use the local heuristic regardless of this setting.
OPENAI_BATCH_ANALYSIS=true
# Per-feature toggles for the two stages that previously ran on local ML
# models (HuggingFace transformer / spaCy NER) rather than a heuristic.
# Set to false to keep using the local model even when an OpenAI key is
# configured. The local model is always used as a fallback regardless of
# these settings if OpenAI fails for any reason.
USE_OPENAI_FOR_EMOTION=true
USE_OPENAI_FOR_CHARACTERS=true

