# --- Database ---
# Postgres connection string (Render/Fly/Railway/etc all provide one).
# For quick local testing you can use SQLite instead:
#   DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Generate a real secret for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# --- AI pipeline ---
# If true, script upload waits for the entire AI pipeline to finish before
# responding (simpler, but the upload request can take 10-60s depending on
# script length and whether the models are already warmed). If false
# (default), upload returns immediately with status="processing" and the
# pipeline runs in a background task; poll GET /scripts/{id}/dashboard and
# watch `pipeline_stage` advance until status flips to "completed".
RUN_PIPELINE_SYNC=false
